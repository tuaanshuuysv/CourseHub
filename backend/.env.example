PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/coursehub
JWT_SECRET=coursehub_mern_jwt_secret_2026
JWT_EXPIRES_IN=7d
CLIENT_URLS=http://localhost:5176,http://localhost:5175,http://localhost:5173

# Cau hinh SMTP gui ma OTP that ve email (khuyen dung Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="CourseHub <your_gmail@gmail.com>"

# Google OAuth 2.0 Web Client ID (lay tu Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
